[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
rusteal-runtime = { workspace = true }
bindings = { package = "{{ crate_name }}-bindings", path = "../bindings" }
glam = { workspace = true }
log = { workspace = true }
