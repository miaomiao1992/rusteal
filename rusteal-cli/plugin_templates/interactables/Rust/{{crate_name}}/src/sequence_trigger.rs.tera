use bindings::engine::{Actor, SphereComponent, SphereComponentExt};
use bindings::level_sequence::{LevelSequenceActor, LevelSequenceActorExt};
use bindings::movie_scene::MovieSceneSequencePlayerExt;
use rusteal_runtime::runtime::{RustealResult, UObjectRef};
use rusteal_runtime::{uclass, uclass_impl};

const TRIGGER_RADIUS: f32 = 400.0;

#[uclass(parent = Actor)]
pub struct SequenceTrigger {
    #[component(root, name = "Sphere")]
    sphere: SphereComponent,

    #[uproperty(
        EditAnywhere,
        BlueprintReadWrite,
        name = "Seq Ref",
        category = "Sequence"
    )]
    seq_ref: UObjectRef<LevelSequenceActor>,
}

#[uclass_impl]
impl SequenceTrigger {
    #[class_defaults]
    fn class_defaults(&mut self) -> RustealResult<()> {
        self.sphere()?
            .checked()?
            .set_sphere_radius(TRIGGER_RADIUS, Some(false));
        Ok(())
    }

    #[ufunction(Override)]
    fn receive_actor_begin_overlap(&mut self, _other_actor: UObjectRef<Actor>) {
        if let Ok(sequence) = self.seq_ref().checked()
            && let Ok(player) = sequence.get_sequence_player().checked()
        {
            player.play();
        }
    }
}
